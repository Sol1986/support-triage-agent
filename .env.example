GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.6-flash
LLM_ENABLED=false

POSTGRES_DB=support_triage
POSTGRES_USER=support_user
POSTGRES_PASSWORD=replace_with_a_password
DATABASE_ENABLED=true
DATABASE_URL=postgresql+psycopg://support_user:replace_with_a_password@db:5432/support_triage

# LangSmith tracing (offline evals, experiments, production traces) — optional.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace_with_your_key
LANGSMITH_PROJECT=support-triage-local

# Eval harness: run the Gemini-backed LLM-judge evaluators (see evals/llm_judge.py).
# Off by default — the deterministic evaluators cover CI; judge runs are manual/scheduled.
LLM_JUDGE_ENABLED=false